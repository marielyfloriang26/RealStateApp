## Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.
# See https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Ob]j/
[Log]s/

# Standard Build Folders
bin/
Bin/
obj/
Obj/
_ReSharper*/

# Visual Studio 2015/2017/2019/2022 cache directory
.vs/
# Target directories or files within the .vs directory may be explicitly allowed:
#!.vs/ProjectSettings.json

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-agent*

# Developer Express DB file
App_Data/*.ldf
App_Data/*.mdf

# Rider / IntelliJ JetBrains
.idea/
*.sln.iml
*.suo
*.sln.docstates

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio Code
.history/

# Windows image analyses/cache
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# macOS files
.DS_Store
.AppleDouble
.LSOverride

# Secrets / Configuration
appsettings.Development.json
appsettings.Production.json
appsettings.local.json
.env
.env.*
!.env.example
secrets.json

# Paket dependency manager
.paket/

# F# Image compilation packager
img/

# DB files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Backup and temporary files
*~
*.tmp
*.temp
*.bak
*.log
*.err

# Node.js / npm / packages
node_modules/
jspm_packages/
web_modules/
.npm/
.eslintcache
.stylelintcache
