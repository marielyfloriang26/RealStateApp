@{
    ViewData["Title"] = "Cerrar Sesión";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body text-center py-5">
                    <h3 class="mb-4 text-warning">Cierre de Sesión</h3>
                    
                    <p class="fs-5 mb-4">
                        ¿Está seguro que desea cerrar sesión en el sistema?
                    </p>

                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <div class="d-flex justify-content-center gap-3">
                            <a href="javascript:history.back()" class="btn btn-secondary px-4">Cancelar</a>
                            <button type="submit" class="btn btn-danger px-4">Cerrar sesión</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>