
@using RealStateApp.Application.ViewModels.User

@model LoginViewModel
<h2>Iniciar sesión</h2>

<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    
    <div class="mb-3">
        <label>Correo o nombre de usuario</label>
        <input asp-for="EmailOrUserName" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Contraseña</label>
        <input asp-for="Password" class="form-control" />
    </div>
    
    <button type="submit" class="btn btn-primary">Iniciar sesión</button>
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Volver</a>
</form>