@using RealStateApp.Application.ViewModels.Mejoras
@model List<MejoraViewModel>
@{
    ViewData["Title"] = "Mantenimiento de mejoras";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm">
        <h2 class="fw-bold mb-0 text-dark">Mantenimiento de mejoras</h2>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Crear mejora
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 text-center">
            <i class="bi bi-info-circle fs-1 text-warning d-block mb-2"></i>
            <h5 class="fw-bold text-dark mb-0">No existen mejoras registradas.</h5>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="bg-light text-secondary">
                        <tr>
                            <th class="py-3 px-4 fw-semibold border-0">Nombre de la mejora</th>
                            <th class="py-3 px-4 fw-semibold border-0">Descripción</th>
                            <th class="py-3 px-4 fw-semibold border-0 text-center">Cantidad de propiedades asociadas</th>
                            <th class="py-3 px-4 fw-semibold border-0 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var mejora in Model)
                        {
                            <tr>
                                <td class="px-4 py-3 fw-medium text-dark">@mejora.Nombre</td>
                                <td class="px-4 py-3 text-muted">@mejora.Descripcion</td>
                                <td class="px-4 py-3 text-center">
                                    <span class="badge bg-secondary rounded-pill px-3 py-2">@mejora.CantidadPropiedades</span>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@mejora.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-semibold">Editar</a>
                                        <a asp-action="Delete" asp-route-id="@mejora.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">Eliminar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
