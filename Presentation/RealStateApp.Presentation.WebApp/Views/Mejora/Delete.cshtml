@model RealStateApp.Application.ViewModels.Mejoras.SaveMejoraViewModel

@{
    ViewData["Title"] = "Eliminar mejora";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="bg-danger text-white py-4 px-4 border-0" style="background: linear-gradient(135deg, #dc3545, #b02a37);">
                    <h4 class="mb-1 fw-bold"><i class="bi bi-exclamation-octagon-fill me-2"></i>Eliminar mejora</h4>
                    <p class="text-white-50 small mb-0">Confirmación de eliminación de la mejora.</p>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="my-3">
                        <i class="bi bi-trash3-fill text-danger" style="font-size: 3.5rem;"></i>
                    </div>
                    
                    <h5 class="text-danger fw-bold mb-4">¿Está seguro que desea eliminar esta mejora?</h5>
                    
                    <div class="bg-light p-3 rounded-3 mb-4 text-start">
                        <div class="mb-2"><strong class="text-secondary small d-block">Mejora:</strong> <span class="fw-bold text-dark fs-5">@Model.Nombre</span></div>
                        <div><strong class="text-secondary small d-block">Descripción:</strong> <span class="text-muted">@Model.Descripcion</span></div>
                    </div>

                    <form asp-action="DeletePost" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-3 mt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                                Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold shadow-sm">
                                Aceptar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
