@using RealStateApp.Application.ViewModels.Mejoras
@model SaveMejoraViewModel
@{
    ViewData["Title"] = "Editar mejora";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 pb-0 px-4 text-center">
                    <h3 class="fw-bold mb-0 text-warning">Editar mejora</h3>
                </div>
                <div class="card-body p-4">
                    @if (Model.HasError)
                    {
                        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-4">
                            <label asp-for="Nombre" class="form-label fw-semibold text-secondary small">Nombre de la mejora</label>
                            <input asp-for="Nombre" class="form-control form-control-lg rounded-3 border-light bg-light" />
                            <span asp-validation-for="Nombre" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-semibold text-secondary small">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control rounded-3 border-light bg-light" rows="4"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">Volver atrás</a>
                            <button type="submit" class="btn btn-warning rounded-pill px-5 py-2 fw-bold text-white shadow-sm">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
