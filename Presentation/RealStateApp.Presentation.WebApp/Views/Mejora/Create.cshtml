@using RealStateApp.Application.ViewModels.Mejoras
@model SaveMejoraViewModel
@{
    ViewData["Title"] = "Crear mejora";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
                <div class="bg-primary text-white py-4 px-4 border-0" style="background: linear-gradient(135deg, #2563eb, #3b82f6);">
                    <h4 class="mb-1 fw-bold"><i class="bi bi-plus-circle-fill me-2"></i>Crear mejora</h4>
                    <p class="text-white-50 small mb-0">Registre una nueva característica o servicio para las propiedades.</p>
                </div>
                <div class="card-body p-4">
                    @if (Model.HasError)
                    {
                        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Create" method="post">
                        <div class="mb-4">
                            <label asp-for="Nombre" class="form-label fw-semibold text-secondary small">Nombre de la mejora</label>
                            <input asp-for="Nombre" class="form-control form-control-lg rounded-3 border-2 border-light bg-light" placeholder="Ej. Piscina" />
                            <span asp-validation-for="Nombre" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-semibold text-secondary small">Descripción</label>
                            <textarea asp-for="Descripcion" class="form-control rounded-3 border-2 border-light bg-light" rows="4" placeholder="Breve descripción de la mejora..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">Volver atrás</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm">Crear mejora</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
