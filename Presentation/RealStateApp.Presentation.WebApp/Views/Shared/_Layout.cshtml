<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealStateApp</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealStateApp.Presentation.WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark-gradient border-bottom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold text-white fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="text-gradient me-1">RealEstate</span><span class="fw-light">App</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Agente"))
                        {
                            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                <li class="nav-item">
                                    <a class="nav-link text-white-50" asp-controller="Agente" asp-action="Index">Home del Agente</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white-50" asp-controller="Agente" asp-action="Perfil">Mi Perfil</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-white-50" asp-controller="MantenimientoPropiedad" asp-action="Index">Mantenimiento de Propiedades</a>
                                </li>
                            </ul>
                            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center gap-2">
                                <li class="nav-item text-white-50 me-2 small">
                                    Bienvenido, <span class="fw-bold text-white">@User.Identity.Name</span>
                                </li>
                                <li class="nav-item">
                                    <!-- Reemplaza asp-controller="User" por el controlador de autenticación de tu Persona 1 si es diferente -->
                                    <form asp-controller="User" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-outline-light rounded-pill px-3 py-1.5 btn-sm">Cerrar sesión</button>
                                    </form>
                                </li>
                            </ul>
                        }
                    }
                    else
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white-50" asp-controller="Home" asp-action="Agentes">Agentes</a>
                            </li>
                        </ul>
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center gap-2">
                            <li class="nav-item">
                                <a class="btn btn-outline-light rounded-pill px-3 py-1.5 btn-sm" asp-controller="Home" asp-action="Unete">Únete a la app</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-gradient rounded-pill px-4 py-1.5 btn-sm" asp-controller="Home" asp-action="Login">Iniciar sesión</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container pb-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer bg-white py-4 mt-auto shadow-sm">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <p class="mb-0 text-muted">&copy; 2026 - <span class="fw-bold text-dark">RealEstateApp</span>. Todos los derechos reservados.</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a class="text-muted text-decoration-none me-3" href="#">Términos</a>
                    <a class="text-muted text-decoration-none" href="#">Privacidad</a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>