@model RealStateApp.Domain.Entities.Usuario

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Confirmar Eliminación</h4>
                </div>
                <div class="card-body">
                    <h5 class="card-title">¿Está seguro de eliminar a este agente?</h5>
                    <p class="card-text">
                        Esta acción eliminará permanentemente a: 
                        <strong>@Model.Nombre @Model.Apellido</strong>.
                    </p>
                    <p class="text-danger">
                        <strong>Atención:</strong> Se eliminarán todas las propiedades, imágenes, ofertas, mensajes y mejoras asociadas a este agente. Esta acción no se puede deshacer.
                    </p>

                    <form asp-action="ConfirmarEliminarAgente" asp-route-id="@Model.Id" method="post" class="mt-4">
                        <div class="d-flex justify-content-between">
                            <a asp-action="ListarAgentes" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-danger">Aceptar, eliminar agente</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>