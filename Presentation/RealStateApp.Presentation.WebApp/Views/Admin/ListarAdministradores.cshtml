@model List<RealStateApp.Application.ViewModels.Admin.AdministradorViewModel>

<div class="container mt-4">
    <h2>Mantenimiento de Administradores</h2>
    
    <div class="d-flex justify-content-end mb-3">
        <a asp-action="CrearAdministrador" class="btn btn-primary">Crear administrador</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Usuario</th>
                <th>Cédula</th>
                <th>Correo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Apellido</td>
                    <td>@item.UserName</td>
                    <td>@item.Cedula</td>
                    <td>@item.Email</td>
                    <td>@(item.EsActivo ? "Activo" : "Inactivo")</td>
                    <td>
                        <a asp-action="EditarAdministrador" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                        
                        <!-- Formulario para Activar/Inactivar -->
                        <form asp-action="CambiarEstadoAdmin" asp-route-id="@item.Id" method="post" class="d-inline" 
                              onsubmit="return confirm('¿Está seguro que desea @(item.EsActivo ? "inactivar" : "activar") este administrador?');">
                            <button type="submit" class="btn btn-sm @(item.EsActivo ? "btn-warning" : "btn-success")">
                                @(item.EsActivo ? "Inactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>