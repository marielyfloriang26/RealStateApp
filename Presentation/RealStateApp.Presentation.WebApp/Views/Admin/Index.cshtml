@{
    ViewData["Title"] = "Dashboard Administrador";
    var d = ViewBag.DashboardData;
}

<div class="container-fluid">
    <h2 class="mb-4">Panel de Administración</h2>
    
    <div class="row">
        <div class="col-md-3">
            <div class="card bg-success text-white p-3 mb-3">
                <h5>Propiedades Disponibles</h5>
                <h2>@d.PropiedadesDisponibles</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white p-3 mb-3">
                <h5>Propiedades Vendidas</h5>
                <h2>@d.PropiedadesVendidas</h2>
            </div>
        </div>
        </div>
</div>