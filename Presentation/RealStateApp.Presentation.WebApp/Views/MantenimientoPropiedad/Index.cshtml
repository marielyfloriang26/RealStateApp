@model IEnumerable<RealStateApp.Application.ViewModels.Propiedades.PropiedadViewModel>
@{
    ViewData["Title"] = "Mantenimiento de Propiedades";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Mantenimiento de Propiedades</h2>
        <a asp-action="Create" class="btn btn-primary">Crear propiedad</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No tiene propiedades disponibles registradas en este momento.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(item.ImagenPrincipalUrl))
                        {
                            <img src="@item.ImagenPrincipalUrl" class="card-img-top" alt="Propiedad" style="height:200px; object-fit:cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center" style="height:200px;">
                                <span>Sin Imagen</span>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title">@item.TipoPropiedadNombre - @item.Codigo</h5>
                            <p class="card-text text-muted">@item.TipoVentaNombre</p>
                            <p class="card-text fw-bold">RD$ @item.Precio.ToString("N2")</p>
                            <div class="d-flex justify-content-between mb-2">
                                <span><i class="bi bi-door-open"></i> @item.CantidadHabitaciones Hab</span>
                                <span><i class="bi bi-droplet"></i> @item.CantidadBanos Baños</span>
                                <span><i class="bi bi-arrows-fullscreen"></i> @item.TamanoMetros mt2</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Eliminar</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
