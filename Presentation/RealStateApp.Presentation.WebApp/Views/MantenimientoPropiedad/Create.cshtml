@model RealStateApp.Application.ViewModels.Propiedades.SavePropiedadViewModel
@{
    ViewData["Title"] = "Crear Propiedad";
}

<div class="container mt-4">
    <h2>Crear Propiedad</h2>
    <hr />

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="TipoPropiedadId" class="form-label"></label>
                <select asp-for="TipoPropiedadId" asp-items="ViewBag.TiposPropiedad" class="form-select">
                    <option value="">-- Seleccione un Tipo de Propiedad --</option>
                </select>
                <span asp-validation-for="TipoPropiedadId" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="TipoVentaId" class="form-label"></label>
                <select asp-for="TipoVentaId" asp-items="ViewBag.TiposVenta" class="form-select">
                    <option value="">-- Seleccione un Tipo de Venta --</option>
                </select>
                <span asp-validation-for="TipoVentaId" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Precio" class="form-label"></label>
                <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="TamanoMetros" class="form-label"></label>
                <input asp-for="TamanoMetros" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="TamanoMetros" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="CantidadHabitaciones" class="form-label"></label>
                <input asp-for="CantidadHabitaciones" type="number" class="form-control" />
                <span asp-validation-for="CantidadHabitaciones" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="CantidadBanos" class="form-label"></label>
                <input asp-for="CantidadBanos" type="number" class="form-control" />
                <span asp-validation-for="CantidadBanos" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Mejoras</label>
            <div class="row">
                @foreach (var mejora in ViewBag.Mejoras)
                {
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="MejorasIds" value="@mejora.Id" id="mejora_@mejora.Id">
                            <label class="form-check-label" for="mejora_@mejora.Id">
                                @mejora.Nombre
                            </label>
                        </div>
                    </div>
                }
            </div>
            <span asp-validation-for="MejorasIds" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label class="form-label">Imágenes (Máximo 4, formatos permitidos: .jpg, .jpeg, .png)</label>
            <input asp-for="ImagenesFiles" type="file" class="form-control" multiple accept=".jpg,.jpeg,.png" />
            <span asp-validation-for="ImagenesFiles" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
            <button type="submit" class="btn btn-primary">Crear propiedad</button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
