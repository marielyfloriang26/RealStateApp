@using RealStateApp.Application.ViewModels.Propiedad
@model RealStateApp.Application.ViewModels.Propiedad.PropiedadViewModel
@{
    ViewData["Title"] = "Detalle de Propiedad";
    var chatHistory = ViewBag.ChatHistory as List<MensajeViewModel> ?? new List<MensajeViewModel>();
    var ofertas = ViewBag.Ofertas as List<OfertaViewModel> ?? new List<OfertaViewModel>();
    bool hasPendingOffer = ViewBag.HasPendingOffer ?? false;
    bool hasAcceptedOffer = ViewBag.HasAcceptedOffer ?? false;
    bool isSold = Model.Estado == "Vendida";
}

<!-- Toast de alertas -->
@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div class="toast show align-items-center text-white @(TempData["SuccessMessage"] != null ? "bg-success" : "bg-danger") border-0 rounded-3 shadow" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi @(TempData["SuccessMessage"] != null ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
                    @(TempData["SuccessMessage"] ?? TempData["ErrorMessage"])
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<div class="container my-5">
    <div class="row">
        <!-- Columna de detalles (Slider, Info, Ofertas) -->
        <div class="col-lg-8 mb-4">
            <!-- Carousel de imágenes -->
            <div id="propertyCarousel" class="carousel slide shadow rounded-4 overflow-hidden mb-4" data-bs-ride="carousel">
                <div class="carousel-inner" style="height: 400px;">
                    @if (Model.ImagenesUrl != null && Model.ImagenesUrl.Count > 0)
                    {
                        for (int i = 0; i < Model.ImagenesUrl.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "") h-100">
                                <img src="@Model.ImagenesUrl[i]" class="d-block w-100 h-100 object-fit-cover" alt="Propiedad" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="carousel-item active h-100 bg-light d-flex flex-column justify-content-center align-items-center text-muted">
                            <i class="bi bi-house fs-1 mb-3"></i>
                            <span class="fs-5">Imagen no disponible</span>
                        </div>
                    }
                </div>
                @if (Model.ImagenesUrl != null && Model.ImagenesUrl.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                }
            </div>

            <!-- Ficha Tecnica -->
            <div class="card border-0 shadow-sm p-4 rounded-4 mb-4 bg-white">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                    <h2 class="fw-bold mb-0 text-dark">@Model.TipoPropiedadNombre en @Model.TipoVentaNombre</h2>
                    <span class="fs-3 fw-bold text-primary">RD$ @Model.Precio.ToString("N2")</span>
                </div>

                <div class="d-flex gap-2 mb-4">
                    <span class="badge bg-secondary rounded-pill px-3 py-1.5 fw-bold shadow-sm">Código: @Model.Codigo</span>
                    <span class="badge @(isSold ? "bg-danger" : "bg-success") rounded-pill px-3 py-1.5 fw-bold shadow-sm">@Model.Estado</span>
                </div>

                <div class="row g-3 text-center mb-4">
                    <div class="col-4">
                        <div class="p-3 rounded bg-light">
                            <div class="small text-muted fw-semibold">Habitaciones</div>
                            <div class="fs-4 fw-bold">@Model.CantidadHabitaciones</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded bg-light">
                            <div class="small text-muted fw-semibold">Baños</div>
                            <div class="fs-4 fw-bold">@Model.CantidadBanos</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 rounded bg-light">
                            <div class="small text-muted fw-semibold">Tamaño</div>
                            <div class="fs-4 fw-bold">@Model.TamanoMetros.ToString("N0") m²</div>
                        </div>
                    </div>
                </div>

                <h4 class="fw-bold text-dark mb-3">Descripción</h4>
                <p class="text-secondary leading-relaxed mb-4">@Model.Descripcion</p>

                <h4 class="fw-bold text-dark mb-3">Mejoras</h4>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var mejora in Model.Mejoras)
                    {
                        <span class="badge bg-light text-dark border border-2 rounded-pill px-3 py-2 fw-semibold">
                            <i class="bi bi-check2-circle text-primary me-1"></i> @mejora
                        </span>
                    }
                </div>
            </div>

            <!-- Seccion de Ofertas -->
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold text-dark mb-0">Mis Ofertas para esta Propiedad</h4>
                    
                    @if (isSold)
                    {
                        <span class="text-danger small fw-semibold"><i class="bi bi-x-circle-fill"></i> Propiedad ya vendida</span>
                    }
                    else if (hasAcceptedOffer)
                    {
                        <span class="text-danger small fw-semibold"><i class="bi bi-x-circle-fill"></i> Ya hay una oferta aceptada</span>
                    }
                    else if (hasPendingOffer)
                    {
                        <span class="text-warning small fw-semibold"><i class="bi bi-exclamation-circle-fill"></i> Tienes una oferta pendiente</span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#ofertaModal">
                            Enviar nueva oferta
                        </button>
                    }
                </div>

                <!-- Historial de ofertas -->
                @if (ofertas.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr class="text-secondary small">
                                    <th>Fecha</th>
                                    <th>Monto Oferta</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in ofertas)
                                {
                                    <tr>
                                        <td class="small">@o.FechaOferta.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")</td>
                                        <td class="fw-bold text-dark">RD$ @o.Monto.ToString("N2")</td>
                                        <td>
                                            @if (o.Estado == "Pendiente")
                                            {
                                                <span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-pill">Pendiente</span>
                                            }
                                            else if (o.Estado == "Aceptada")
                                            {
                                                <span class="badge bg-success text-white px-2.5 py-1.5 rounded-pill">Aceptada</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger text-white px-2.5 py-1.5 rounded-pill">Rechazada</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">Aún no has realizado ninguna oferta por esta propiedad.</p>
                }
            </div>
        </div>

        <!-- Columna Lateral (Agente y Chat) -->
        <div class="col-lg-4">
            <!-- Tarjeta del Agente -->
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white text-center mb-4">
                <h5 class="fw-bold text-dark mb-4">Agente Responsable</h5>
                <div class="mb-3 d-inline-block">
                    @if (!string.IsNullOrEmpty(Model.AgenteFotoUrl))
                    {
                        <img src="@Model.AgenteFotoUrl" class="rounded-circle border border-4 border-light shadow-sm" style="width: 100px; height: 100px; object-fit: cover;" alt="Agente" />
                    }
                    else
                    {
                        <div class="rounded-circle border border-4 border-light shadow bg-light d-flex justify-content-center align-items-center text-muted" style="width: 100px; height: 100px; margin: 0 auto;">
                            <i class="bi bi-person-fill fs-2"></i>
                        </div>
                    }
                </div>
                <h5 class="fw-bold text-dark mb-1">@Model.AgenteNombre @Model.AgenteApellido</h5>
                <p class="text-primary small fw-semibold mb-0">Agente Inmobiliario</p>

                <!-- Datos de contacto del Agente -->
                <div class="text-start border-top pt-3">
                    <div class="d-flex align-items-center mb-2">
                        <div class="bg-light p-2 rounded-circle me-2.5 text-primary small">
                            <i class="bi bi-telephone-fill"></i>
                        </div>
                        <div style="font-size: 0.85rem;">
                            <div class="text-muted fw-semibold" style="font-size: 0.75rem;">Teléfono</div>
                            <div class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.AgenteTelefono) ? "No especificado" : Model.AgenteTelefono)</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center" style="word-break: break-all;">
                        <div class="bg-light p-2 rounded-circle me-2.5 text-primary small">
                            <i class="bi bi-envelope-fill"></i>
                        </div>
                        <div style="font-size: 0.85rem;">
                            <div class="text-muted fw-semibold" style="font-size: 0.75rem;">Correo Electrónico</div>
                            <div class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.AgenteCorreo) ? "No especificado" : Model.AgenteCorreo)</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chat -->
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white d-flex flex-column" style="height: 450px;">
                <h5 class="fw-bold text-dark mb-3">Chat con el Agente</h5>

                <!-- Historial de mensajes -->
                <div class="flex-grow-1 overflow-y-auto mb-3 p-2 bg-light rounded-3" style="max-height: 300px;">
                    @if (chatHistory.Count > 0)
                    {
                        foreach (var msg in chatHistory)
                        {
                            var isMe = msg.Remitente == "Cliente";
                            <div class="d-flex flex-column mb-2 @(isMe ? "align-items-end" : "align-items-start")">
                                <div class="p-2.5 rounded-3 text-white max-w-75 @(isMe ? "bg-primary" : "bg-secondary")" style="font-size: 0.875rem;">
                                    @msg.Contenido
                                </div>
                                <span class="text-muted" style="font-size: 0.65rem; margin-top: 2px;">
                                    @msg.FechaEnvio.ToLocalTime().ToString("hh:mm tt")
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="h-100 d-flex align-items-center justify-content-center text-center">
                            <span class="text-muted small">Escribe un mensaje abajo para iniciar la conversación.</span>
                        </div>
                    }
                </div>

                <!-- Input para mandar mensaje -->
                @if (isSold)
                {
                    <div class="alert alert-light border text-center py-2 mb-0 small">
                        El chat está cerrado debido a que la propiedad fue vendida.
                    </div>
                }
                else
                {
                    <form asp-action="EnviarMensaje" method="post" class="mt-auto">
                        <input type="hidden" name="propiedadId" value="@Model.Id" />
                        <input type="hidden" name="agenteId" value="@Model.AgenteId" />
                        <div class="input-group">
                            <input type="text" name="contenido" placeholder="Escribe tu mensaje..." class="form-control rounded-start-pill border-2 border-light px-3" required />
                            <button type="submit" class="btn btn-primary rounded-end-pill px-3">
                                <i class="bi bi-send"></i>
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal para Enviar Oferta -->
<div class="modal fade" id="ofertaModal" tabindex="-1" aria-labelledby="ofertaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="ofertaModalLabel">Enviar Nueva Oferta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="EnviarOferta" method="post">
                <div class="modal-body py-4">
                    <input type="hidden" name="propiedadId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label text-secondary fw-semibold">Monto de la Oferta (DOP)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold border-2 border-light">RD$</span>
                            <input type="number" name="monto" min="1" step="0.01" class="form-control border-2 border-light py-2.5 fw-bold" placeholder="Ej. 4200000" required />
                        </div>
                        <span class="form-text text-muted small mt-1 d-block">Indica el valor que deseas ofertar por esta propiedad.</span>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow">Enviar Oferta</button>
                </div>
            </form>
        </div>
    </div>
</div>