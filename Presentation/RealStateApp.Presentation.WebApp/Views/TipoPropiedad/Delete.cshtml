@model RealStateApp.Application.ViewModels.TipoPropiedades.SaveTipoPropiedadViewModel

@{
    ViewData["Title"] = "Eliminar tipo de propiedad";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="bg-danger text-white py-4 px-4 border-0" style="background: linear-gradient(135deg, #dc3545, #b02a37);">
                    <span class="badge bg-white text-danger rounded-pill px-2.5 py-1 fw-bold fs-7 mb-2 shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Acción Irreversible
                    </span>
                    <h4 class="mb-1 fw-bold">Eliminar tipo de propiedad</h4>
                    <p class="text-white-50 small mb-0">Confirmación de eliminación definitiva del recurso y sus dependencias en cascada.</p>
                </div>
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="my-3">
                        <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 88px; height: 88px;">
                            <i class="bi bi-trash3-fill fs-1"></i>
                        </div>
                    </div>
                    
                    <h5 class="text-danger fw-bold mb-4 px-2">¿Está seguro que desea eliminar este tipo de propiedad y todas las propiedades asociadas?</h5>
                    
                    <div class="bg-light p-4 rounded-4 mb-4 text-start border border-light-subtle shadow-sm">
                        <div class="mb-3">
                            <strong class="text-secondary small d-block mb-1">Tipo de propiedad:</strong> 
                            <span class="fw-bold text-dark fs-5">@Model.Nombre</span>
                        </div>
                        <div>
                            <strong class="text-secondary small d-block mb-1">Descripción:</strong> 
                            <span class="text-secondary">@Model.Descripcion</span>
                        </div>
                    </div>

                    <form asp-action="DeletePost" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-3 mt-4 border-top pt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 fw-semibold transition d-inline-flex align-items-center">
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2.5 fw-semibold shadow-sm transition d-inline-flex align-items-center">
                                <i class="bi bi-trash-fill me-2"></i>Aceptar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

