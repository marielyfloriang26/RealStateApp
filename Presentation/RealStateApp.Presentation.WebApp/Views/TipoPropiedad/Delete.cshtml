@model RealStateApp.Application.ViewModels.TipoPropiedades.SaveTipoPropiedadViewModel

@{
    ViewData["Title"] = "Eliminar tipo de propiedad";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Eliminar tipo de propiedad</h4>
                </div>
                <div class="card-body text-center py-5">
                    
                    <h5 class="text-danger mb-4">¿Está seguro que desea eliminar este tipo de propiedad y todas las propiedades asociadas?</h5>
                    
                    <p class="mb-2"><strong>Tipo de propiedad:</strong> @Model.Nombre</p>
                    <p class="mb-4 text-muted">@Model.Descripcion</p>

                    <form asp-action="DeletePost" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                            <button type="submit" class="btn btn-danger px-4">Aceptar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
