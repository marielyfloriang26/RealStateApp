@model RealStateApp.Application.ViewModels.TipoPropiedades.SaveTipoPropiedadViewModel

@{
    ViewData["Title"] = "Editar tipo de propiedad";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="bg-dark-gradient py-4 px-4 text-white border-0">
                    <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 fw-bold fs-7 mb-2 shadow-sm">
                        <i class="bi bi-pencil-square me-1"></i> Edición de Registro
                    </span>
                    <h4 class="mb-1 fw-bold">Editar tipo de propiedad</h4>
                    <p class="text-white-50 small mb-0">Modifica los detalles del tipo de propiedad seleccionado.</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />

                        @if (Model.HasError)
                        {
                            <div class="alert alert-danger border-0 shadow-sm p-3 rounded-4 mb-4 d-flex align-items-center" role="alert">
                                <div class="bg-danger-subtle text-danger p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                </div>
                                <div class="text-danger small fw-medium">
                                    @Model.Error
                                </div>
                            </div>
                        }
                        else if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm p-3 rounded-4 mb-4 d-flex align-items-center" role="alert">
                                <div class="bg-danger-subtle text-danger p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                </div>
                                <div class="text-danger small fw-medium">
                                    @Html.ValidationSummary(true, "", new { @class = "mb-0 list-unstyled" })
                                </div>
                            </div>
                        }

                        <div class="mb-4">
                            <label asp-for="Nombre" class="form-label fw-semibold text-secondary small mb-1">Nombre del tipo de propiedad <span class="text-danger">*</span></label>
                            <input asp-for="Nombre" class="form-control rounded-3 border-2 border-light py-2.5 px-3.5 focus-none shadow-none" placeholder="Nombre que identificará el tipo de propiedad" autocomplete="off" />
                            <span asp-validation-for="Nombre" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-semibold text-secondary small mb-1">Descripción <span class="text-danger">*</span></label>
                            <textarea asp-for="Descripcion" class="form-control rounded-3 border-2 border-light py-2.5 px-3.5 focus-none shadow-none" rows="4" placeholder="Descripción general del tipo de propiedad"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 fw-semibold transition d-inline-flex align-items-center">
                                <i class="bi bi-arrow-left me-2"></i>Volver atrás
                            </a>
                            <button type="submit" class="btn btn-gradient rounded-pill px-4 py-2.5 fw-semibold shadow-sm transition d-inline-flex align-items-center">
                                <i class="bi bi-save-fill me-2 fs-5"></i>Guardar cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

