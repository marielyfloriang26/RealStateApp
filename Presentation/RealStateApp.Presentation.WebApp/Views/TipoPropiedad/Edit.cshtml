@model RealStateApp.Application.ViewModels.TipoPropiedades.SaveTipoPropiedadViewModel

@{
    ViewData["Title"] = "Editar tipo de propiedad";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                <div class="bg-dark-gradient py-4 px-4 text-white border-0" style="background: linear-gradient(135deg, #0f172a, #1e293b);">
                    <h4 class="mb-1 fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i>Editar tipo de propiedad</h4>
                    <p class="text-white-50 small mb-0">Modifica los detalles del tipo de propiedad seleccionado.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        
                        <input type="hidden" asp-for="Id" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger border-0 shadow-sm p-3 rounded-4 mb-4" role="alert">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-exclamation-triangle-fill fs-5 text-danger me-2"></i>
                                    <div class="fw-bold">Por favor, corrige los siguientes errores:</div>
                                </div>
                                <div class="mt-2 text-danger small">
                                    @Html.ValidationSummary(false, "")
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold text-secondary small">Nombre del tipo de propiedad <span class="text-danger">*</span></label>
                            <input asp-for="Nombre" class="form-control rounded-3 border-2 border-light py-2.5 px-3" placeholder="Nombre que identificará el tipo de propiedad" autocomplete="off" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-semibold text-secondary small">Descripción <span class="text-danger">*</span></label>
                            <textarea asp-for="Descripcion" class="form-control rounded-3 border-2 border-light py-2.5 px-3" rows="4" placeholder="Descripción general del tipo de propiedad"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i>Volver atrás
                            </a>
                            <button type="submit" class="btn btn-gradient rounded-pill px-4 py-2 fw-semibold shadow-sm">
                                Guardar cambios<i class="bi bi-save ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

