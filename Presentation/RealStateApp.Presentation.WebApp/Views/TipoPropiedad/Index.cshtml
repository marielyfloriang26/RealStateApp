@model IEnumerable<RealStateApp.Application.ViewModels.TipoPropiedades.TipoPropiedadViewModel>

@{
    ViewData["Title"] = "Mantenimiento de tipo de propiedades";
}

<div class="container my-4">
    <!-- Hero Header Banner -->
    <div class="hero-section text-white py-5 px-4 mb-5 rounded-4 shadow-lg position-relative overflow-hidden">
        <div class="position-absolute top-0 end-0 p-5 opacity-10 pe-none">
            <i class="bi bi-buildings-fill" style="font-size: 14rem;"></i>
        </div>
        <div class="position-relative z-1 py-2">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-4">
                <div class="text-center text-md-start">
                    <span class="badge bg-primary text-white rounded-pill px-3 py-1 fw-bold small mb-3 shadow-sm d-inline-flex align-items-center">
                        <i class="bi bi-shield-lock-fill me-2"></i> Módulo de Administrador
                    </span>
                    <h1 class="display-5 fw-bold mb-2">Mantenimiento de tipo de propiedades</h1>
                    <p class="lead mb-0 opacity-75">Gestiona el catálogo oficial de tipos de propiedades disponibles en el sistema</p>
                </div>
                <div>
                    <a asp-action="Create" class="btn btn-gradient rounded-pill px-4 py-3 fw-bold shadow-lg d-inline-flex align-items-center fs-6">
                        <i class="bi bi-plus-circle-fill me-2 fs-5"></i>Crear tipo de propiedad
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas de Éxito y Error -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm p-3 rounded-4 mb-4 alert-dismissible fade show d-flex align-items-center" role="alert">
            <div class="bg-success-subtle text-success p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                <i class="bi bi-check-circle-fill fs-4"></i>
            </div>
            <div class="fw-medium text-dark">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger border-0 shadow-sm p-3 rounded-4 mb-4 alert-dismissible fade show d-flex align-items-center" role="alert">
            <div class="bg-danger-subtle text-danger p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                <i class="bi bi-exclamation-triangle-fill fs-4"></i>
            </div>
            <div class="fw-medium text-dark">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Contenido Principal -->
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-3">
            <div class="py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center text-primary mb-4 shadow-sm" style="width: 100px; height: 100px;">
                    <i class="bi bi-folder-x fs-1"></i>
                </div>
                <h3 class="fw-bold text-dark mb-3">No existen tipos de propiedades registrados.</h3>
                <p class="text-muted mb-4 max-w-md mx-auto lead fs-6">Haz clic en el botón superior para registrar el primer tipo de propiedad en el catálogo del sistema.</p>
                <a asp-action="Create" class="btn btn-gradient rounded-pill px-4 py-3 fw-bold shadow-sm d-inline-flex align-items-center">
                    <i class="bi bi-plus-circle-fill me-2 fs-5"></i>Crear tipo de propiedad
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-dark-gradient text-white border-0">
                        <tr>
                            <th class="bg-transparent text-white ps-4 py-4 fw-semibold">Nombre del tipo de propiedad</th>
                            <th class="bg-transparent text-white py-4 fw-semibold">Descripción</th>
                            <th class="bg-transparent text-white py-4 fw-semibold text-center">Cantidad de propiedades asociadas</th>
                            <th class="bg-transparent text-white pe-4 py-4 fw-semibold text-center" style="width: 240px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var item in Model)
                        {
                            <tr class="transition">
                                <td class="ps-4 fw-bold text-dark py-4">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary-subtle text-primary p-2.5 rounded-4 me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px;">
                                            <i class="bi bi-house-door-fill fs-5"></i>
                                        </div>
                                        <span class="fs-6 text-dark">@item.Nombre</span>
                                    </div>
                                </td>
                                <td class="text-secondary py-4">@item.Descripcion</td>
                                <td class="text-center py-4">
                                    <span class="badge bg-light text-primary rounded-pill px-3.5 py-2 fw-bold border border-primary-subtle fs-7 shadow-sm">
                                        <i class="bi bi-buildings-fill me-1"></i> @item.CantidadPropiedadesAsociadas
                                    </span>
                                </td>
                                <td class="pe-4 py-4 text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3.5 py-2 fw-semibold transition d-inline-flex align-items-center">
                                            <i class="bi bi-pencil-square me-1"></i>Editar
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3.5 py-2 fw-semibold transition d-inline-flex align-items-center">
                                            <i class="bi bi-trash-fill me-1"></i>Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
