@model IEnumerable<RealStateApp.Application.ViewModels.TipoVentas.TipoVentaViewModel>

@{
    ViewData["Title"] = "Mantenimiento de tipo de ventas";
}

<div class="container mt-4">
    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1 text-dark">
                    <span class="text-gradient">Mantenimiento de tipo de ventas</span>
                </h2>
                <p class="text-secondary mb-0 small">Administra los tipos de operaciones o ventas disponibles para las propiedades.</p>
            </div>
            <div>
                <a asp-action="Create" class="btn btn-gradient rounded-pill px-4 py-2.5 fw-semibold shadow-sm d-inline-flex align-items-center">
                    <i class="bi bi-plus-lg me-2"></i> Crear tipo de venta
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm rounded-3 alert-dismissible fade show p-3 mb-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger border-0 shadow-sm rounded-3 alert-dismissible fade show p-3 mb-4" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5 bg-light rounded-4">
                <div class="text-muted mb-3">
                    <i class="bi bi-tag-fill fs-1"></i>
                </div>
                <h5 class="fw-bold">No existen tipos de ventas registrados.</h5>
                <p class="text-muted mb-0">Comienza creando un nuevo tipo de venta para el sistema.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle border-light">
                    <thead>
                        <tr class="text-secondary small fw-bold border-bottom border-2 border-light">
                            <th class="py-3 px-3">Nombre del tipo de venta</th>
                            <th class="py-3 px-3">Descripción</th>
                            <th class="py-3 px-3 text-center">Propiedades asociadas</th>
                            <th class="py-3 px-3 text-center" style="width: 220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="border-bottom border-light">
                                <td class="py-3 px-3 fw-semibold text-dark">@item.Nombre</td>
                                <td class="py-3 px-3 text-secondary small">@item.Descripcion</td>
                                <td class="py-3 px-3 text-center">
                                    <span class="badge bg-light text-dark border border-light fw-bold rounded-pill px-3 py-1.5 fs-7">
                                        @item.CantidadPropiedadesAsociadas
                                    </span>
                                </td>
                                <td class="py-3 px-3 text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-semibold d-inline-flex align-items-center">
                                            <i class="bi bi-pencil-fill me-1"></i> Editar
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold d-inline-flex align-items-center">
                                            <i class="bi bi-trash-fill me-1"></i> Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
