@{
    ViewData["Title"] = "Propiedad No Encontrada";
}

<div class="container my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg p-5 glass-card rounded-4">
                <div class="text-danger mb-4">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem;"></i>
                </div>
                <h2 class="mb-3 text-dark fw-bold">Propiedad no disponible</h2>
                <p class="text-muted fs-5">La propiedad solicitada no existe o no se encuentra disponible.</p>
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill shadow">
                        Volver al Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>