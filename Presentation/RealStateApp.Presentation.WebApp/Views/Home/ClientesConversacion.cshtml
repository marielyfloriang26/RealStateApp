@model List<RealStateApp.Application.ViewModels.Agente.AgentClienteConversacionViewModel>

@{
    ViewData["Title"] = "Conversaciones";
    var propiedadId = ViewBag.PropiedadId;
}

<div class="container mt-4">
    <h2>Conversaciones con Clientes</h2>
    
    @if (!Model.Any())
    {
        <p>No hay conversaciones iniciadas para esta propiedad.</p>
    }
    else
    {
        <div class="list-group mt-3">
            @foreach (var cliente in Model)
            {
                <a asp-action="Conversacion" asp-route-propiedadId="@propiedadId" asp-route-clienteId="@cliente.ClienteId" class="list-group-item list-group-item-action">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">@cliente.NombreCliente</h5>
                        <small>@cliente.FechaUltimoMensaje.ToString("g")</small>
                    </div>
                    <p class="mb-1">@cliente.UltimoMensaje</p>
                </a>
            }
        </div>
    }
</div>
