@model List<RealStateApp.Application.ViewModels.Agente.AgentClienteOfertasViewModel>

@{
    ViewData["Title"] = "Clientes con Ofertas";
    var propiedadId = ViewBag.PropiedadId;
}

<div class="container mt-4">
    <h2>Clientes con Ofertas</h2>

    @if (!Model.Any())
    {
        <p>No hay ofertas para esta propiedad.</p>
    }
    else
    {
        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Nombre del Cliente</th>
                    <th>Cantidad de Ofertas</th>
                    <th>Última Oferta (Monto)</th>
                    <th>Estado de la última oferta</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="OfertasPorCliente" asp-route-propiedadId="@propiedadId" asp-route-clienteId="@cliente.ClienteId">
                                @cliente.NombreCliente
                            </a>
                        </td>
                        <td>@cliente.CantidadOfertas</td>
                        <td>$@cliente.UltimaOfertaMonto.ToString("N2")</td>
                        <td>@cliente.EstadoUltimaOferta</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
