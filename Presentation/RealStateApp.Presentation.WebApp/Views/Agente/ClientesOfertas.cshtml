@model List<RealStateApp.Application.ViewModels.Agente.AgentClienteOfertasViewModel>

@{
    ViewData["Title"] = "Clientes con Ofertas - Agente";
    var propiedadId = ViewBag.PropiedadId;
}

<div class="container my-5">
    <!-- Breadcrumb & Header -->
    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a asp-controller="Agente" asp-action="Index" class="text-decoration-none">Home del Agente</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Agente" asp-action="PropiedadDetalle" asp-route-id="@propiedadId" class="text-decoration-none">Detalle de Propiedad</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Ofertas recibidas</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-dark mb-0">
                    Clientes que han realizado ofertas
                </h2>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="Agente" asp-action="PropiedadDetalle" asp-route-id="@propiedadId" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Volver al detalle
                </a>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
        <h4 class="fw-bold mb-4 text-dark">Listado de clientes y resumen de ofertas</h4>
        
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-3 py-3">Nombre del cliente</th>
                            <th class="py-3 text-center">Cantidad de ofertas</th>
                            <th class="py-3">Última oferta</th>
                            <th class="py-3">Estado de la última oferta</th>
                            <th class="pe-3 py-3 text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light p-2 rounded-circle text-success me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        @o.NombreCliente
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-3 py-1 fw-bold">@o.CantidadOfertas</span>
                                </td>
                                <td class="fw-bold text-primary fs-6">RD$ @o.UltimaOfertaMonto.ToString("N2")</td>
                                <td>
                                    @if (o.EstadoUltimaOferta == "Aceptada")
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>@o.EstadoUltimaOferta</span>
                                    }
                                    else if (o.EstadoUltimaOferta == "Rechazada")
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-1"><i class="bi bi-x-circle me-1"></i>@o.EstadoUltimaOferta</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="bi bi-clock me-1"></i>@o.EstadoUltimaOferta</span>
                                    }
                                </td>
                                <td class="pe-3 text-end">
                                    <a asp-action="OfertasPorCliente" asp-route-propiedadId="@propiedadId" asp-route-clienteId="@o.ClienteId" class="btn btn-outline-success rounded-pill px-4 py-1.5 btn-sm fw-semibold">
                                        Ver y responder ofertas
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-cash-coin fs-1 mb-2 d-block text-secondary"></i>
                <p class="mb-0">No hay ofertas registradas para esta propiedad en este momento.</p>
            </div>
        }
    </div>
</div>
