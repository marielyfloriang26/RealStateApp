@model RealStateApp.Application.ViewModels.Agente.AgentPropiedadDetalleViewModel

@{
    ViewData["Title"] = "Detalle de Propiedad - Agente";
}

<div class="container my-5">
    <!-- Breadcrumb & Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Agente" asp-action="Index" class="text-decoration-none">Home del Agente</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Detalle de Propiedad @Model.Codigo</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">
                Detalle de Propiedad: <span class="text-primary">@Model.Codigo</span>
            </h2>
        </div>
        <div>
            <a asp-controller="Agente" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Volver al listado
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Main Column (Imagenes, Info general, Conversaciones, Ofertas) -->
        <div class="col-lg-8 mb-4">
            <!-- Carrusel de imágenes -->
            <div id="propertyCarousel" class="carousel slide shadow rounded-4 overflow-hidden mb-4" data-bs-ride="carousel">
                <div class="carousel-inner" style="height: 450px;">
                    @if (Model.Imagenes != null && Model.Imagenes.Count > 0)
                    {
                        for (int i = 0; i < Model.Imagenes.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "") h-100">
                                <img src="@Model.Imagenes[i]" class="d-block w-100 h-100 object-fit-cover" alt="Imagen @(i+1) de la propiedad" />
                            </div>
                        }
                    }
                    else
                    {
                        <div class="carousel-item active h-100 bg-light d-flex flex-column justify-content-center align-items-center text-muted">
                            <i class="bi bi-house fs-1 mb-3"></i>
                            <span class="fs-5">Imagen no disponible</span>
                        </div>
                    }
                </div>
                @if (Model.Imagenes != null && Model.Imagenes.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Siguiente</span>
                    </button>
                }
            </div>

            <!-- Propiedad Overview (Información General) -->
            <div class="card border-0 shadow-sm p-4 rounded-4 mb-4 bg-white">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold mb-0 text-dark">Información general de la propiedad</h3>
                    <span class="fs-3 fw-bold text-primary">RD$ @Model.Precio.ToString("N2")</span>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <span class="badge bg-primary rounded-pill px-3 py-1.5 fw-bold shadow-sm">@Model.TipoPropiedad</span>
                    <span class="badge bg-success rounded-pill px-3 py-1.5 fw-bold shadow-sm">@Model.TipoVenta</span>
                    <span class="badge bg-secondary rounded-pill px-3 py-1.5 fw-bold shadow-sm">Código: @Model.Codigo</span>
                    @if (Model.Estado == "Disponible")
                    {
                        <span class="badge bg-success rounded-pill px-3 py-1.5 fw-bold shadow-sm"><i class="bi bi-check-circle me-1"></i>Estado: @Model.Estado</span>
                    }
                    else
                    {
                        <span class="badge bg-danger rounded-pill px-3 py-1.5 fw-bold shadow-sm"><i class="bi bi-tag-fill me-1"></i>Estado: @Model.Estado</span>
                    }
                </div>

                <!-- Cuadro de especificaciones -->
                <div class="row g-3 text-center mb-4">
                    <div class="col-6 col-sm-3">
                        <div class="p-3 rounded bg-light">
                            <div class="small text-muted fw-semibold mb-1">Habitaciones</div>
                            <div class="fs-4 fw-bold text-dark">@Model.CantidadHabitaciones</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="p-3 rounded bg-light">
                            <div class="small text-muted fw-semibold mb-1">Baños</div>
                            <div class="fs-4 fw-bold text-dark">@Model.CantidadBanos</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="p-3 rounded bg-light">
                            <div class="small text-muted fw-semibold mb-1">Metros Cuadrados</div>
                            <div class="fs-4 fw-bold text-dark">@Model.TamanoMetros.ToString("N0") m²</div>
                        </div>
                    </div>
                    <div class="col-6 col-sm-3">
                        <div class="p-3 rounded bg-light">
                            <div class="small text-muted fw-semibold mb-1">Estado</div>
                            <div class="fs-4 fw-bold @(Model.Estado == "Disponible" ? "text-success" : "text-danger")">@Model.Estado</div>
                        </div>
                    </div>
                </div>

                <!-- Descripción -->
                <h4 class="fw-bold text-dark mb-3">Descripción</h4>
                <p class="text-secondary leading-relaxed mb-4">
                    @Model.Descripcion
                </p>

                <!-- Mejoras -->
                <h4 class="fw-bold text-dark mb-3">Mejoras de la Propiedad</h4>
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.Mejoras != null && Model.Mejoras.Count > 0)
                    {
                        foreach (var mejora in Model.Mejoras)
                        {
                            <span class="badge bg-light text-dark border border-2 rounded-pill px-3 py-2 fw-semibold">
                                <i class="bi bi-check2-circle text-primary me-1"></i> @mejora
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-muted small">Esta propiedad no posee mejoras registradas.</span>
                    }
                </div>
            </div>

            <!-- Sección de Conversaciones con Clientes -->
            <div class="card border-0 shadow-sm p-4 rounded-4 mb-4 bg-white">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <h4 class="fw-bold text-dark mb-1"><i class="bi bi-chat-dots-fill text-primary me-2"></i>Sección de conversaciones con clientes</h4>
                        <p class="text-muted small mb-0">Listado con los clientes que han enviado mensajes relacionados con la propiedad seleccionada.</p>
                    </div>
                    <a asp-action="ClientesConversacion" asp-route-propiedadId="@Model.Id" class="btn btn-outline-primary rounded-pill px-3 py-1.5 btn-sm fw-semibold">
                        Ver todas
                    </a>
                </div>

                @if (Model.ClientesConversacion != null && Model.ClientesConversacion.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-secondary small text-uppercase">
                                <tr>
                                    <th class="ps-3 py-3">Nombre del cliente</th>
                                    <th class="py-3">Último mensaje</th>
                                    <th class="py-3">Fecha del último mensaje</th>
                                    <th class="pe-3 py-3 text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.ClientesConversacion)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-dark">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-light p-2 rounded-circle text-primary me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                                    <i class="bi bi-person-fill"></i>
                                                </div>
                                                @c.NombreCliente
                                            </div>
                                        </td>
                                        <td class="text-secondary">
                                            <span class="d-inline-block text-truncate" style="max-width: 260px;">@c.UltimoMensaje</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border px-2 py-1">@c.FechaUltimoMensaje.ToLocalTime().ToString("g")</span>
                                        </td>
                                        <td class="pe-3 text-end">
                                            <a asp-action="Conversacion" asp-route-propiedadId="@Model.Id" asp-route-clienteId="@c.ClienteId" class="btn btn-gradient rounded-pill px-3 py-1.5 btn-sm fw-semibold shadow-sm">
                                                Abrir chat
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-chat-square text-secondary fs-2 d-block mb-2"></i>
                        <p class="mb-0">No hay conversaciones iniciadas para esta propiedad en este momento.</p>
                    </div>
                }
            </div>

            <!-- Sección de Ofertas Recibidas -->
            <div class="card border-0 shadow-sm p-4 rounded-4 mb-4 bg-white">
                <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                    <div>
                        <h4 class="fw-bold text-dark mb-1"><i class="bi bi-cash-stack text-success me-2"></i>Sección de ofertas recibidas</h4>
                        <p class="text-muted small mb-0">Listado de los clientes que han realizado ofertas sobre la propiedad seleccionada.</p>
                    </div>
                    <a asp-action="ClientesOfertas" asp-route-propiedadId="@Model.Id" class="btn btn-outline-success rounded-pill px-3 py-1.5 btn-sm fw-semibold">
                        Ver todas
                    </a>
                </div>

                @if (Model.ClientesOfertas != null && Model.ClientesOfertas.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-secondary small text-uppercase">
                                <tr>
                                    <th class="ps-3 py-3">Nombre del cliente</th>
                                    <th class="py-3 text-center">Cantidad de ofertas</th>
                                    <th class="py-3">Última oferta</th>
                                    <th class="py-3">Estado de la última oferta</th>
                                    <th class="pe-3 py-3 text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in Model.ClientesOfertas)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-dark">
                                            <div class="d-flex align-items-center">
                                                <div class="bg-light p-2 rounded-circle text-success me-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                                    <i class="bi bi-person-fill"></i>
                                                </div>
                                                @o.NombreCliente
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border px-3 py-1 fw-bold">@o.CantidadOfertas</span>
                                        </td>
                                        <td class="fw-bold text-primary fs-6">RD$ @o.UltimaOfertaMonto.ToString("N2")</td>
                                        <td>
                                            @if (o.EstadoUltimaOferta == "Aceptada")
                                            {
                                                <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>@o.EstadoUltimaOferta</span>
                                            }
                                            else if (o.EstadoUltimaOferta == "Rechazada")
                                            {
                                                <span class="badge bg-danger rounded-pill px-3 py-1"><i class="bi bi-x-circle me-1"></i>@o.EstadoUltimaOferta</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="bi bi-clock me-1"></i>@o.EstadoUltimaOferta</span>
                                            }
                                        </td>
                                        <td class="pe-3 text-end">
                                            <a asp-action="OfertasPorCliente" asp-route-propiedadId="@Model.Id" asp-route-clienteId="@o.ClienteId" class="btn btn-outline-success rounded-pill px-3 py-1.5 btn-sm fw-semibold">
                                                Ver y responder ofertas
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-cash-coin text-secondary fs-2 d-block mb-2"></i>
                        <p class="mb-0">Ningún cliente ha realizado ofertas para esta propiedad hasta el momento.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Column (Gestión Rápida del Agente) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white sticky-top" style="top: 2rem;">
                <h4 class="fw-bold text-dark mb-3">Gestión del Agente</h4>
                <p class="text-secondary small mb-4">Acceso rápido a las opciones y comunicación con los clientes para esta propiedad.</p>

                <div class="d-flex flex-column gap-3 mb-4">
                    <a asp-action="ClientesConversacion" asp-route-propiedadId="@Model.Id" class="btn btn-gradient rounded-pill py-2.5 fw-semibold shadow-sm d-flex align-items-center justify-content-center">
                        <i class="bi bi-chat-dots-fill me-2"></i> Ver Conversaciones (@(Model.ClientesConversacion?.Count ?? 0))
                    </a>

                    <a asp-action="ClientesOfertas" asp-route-propiedadId="@Model.Id" class="btn btn-outline-success rounded-pill py-2.5 fw-semibold shadow-sm d-flex align-items-center justify-content-center">
                        <i class="bi bi-cash-stack me-2"></i> Ver Ofertas Recibidas (@(Model.ClientesOfertas?.Count ?? 0))
                    </a>
                </div>

                <div class="border-top pt-4 text-start">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-light p-2.5 rounded-circle me-3 text-primary">
                            <i class="bi bi-upc-scan"></i>
                        </div>
                        <div>
                            <div class="small text-muted fw-semibold">Código ID</div>
                            <div class="fw-bold text-dark">@Model.Codigo</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center">
                        <div class="bg-light p-2.5 rounded-circle me-3 text-primary">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <div class="small text-muted fw-semibold">Estado en Portal</div>
                            <div class="fw-bold @(Model.Estado == "Disponible" ? "text-success" : "text-danger")">@Model.Estado</div>
                        </div>
                    </div>
                </div>

                <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-pill py-2.5 fw-bold mt-4">
                    Volver al Listado
                </a>
            </div>
        </div>
    </div>
</div>
