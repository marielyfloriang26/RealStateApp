@using RealStateApp.Application.ViewModels.Propiedad
@model List<PropiedadViewModel>
@{
    var agente = ViewBag.Agente as AgenteViewModel ?? new AgenteViewModel();
    ViewData["Title"] = $"Propiedades de {agente.Nombre}";
}

<div class="container my-4">
    <!-- header card -->
    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-5">
        <div class="d-flex flex-column flex-md-row align-items-center text-center text-md-start">
            <!-- foto agente -->
            <div class="mb-3 mb-md-0 me-md-4">
                @if (!string.IsNullOrEmpty(agente.FotoUrl))
                {
                    <img src="@agente.FotoUrl" class="rounded-circle border border-4 border-light shadow-sm" style="width: 120px; height: 120px; object-fit: cover;" alt="Agente" />
                }
                else
                {
                    <div class="rounded-circle border border-4 border-light shadow-sm bg-light d-flex justify-content-center align-items-center text-muted" style="width: 120px; height: 120px;">
                        <i class="bi bi-person-fill fs-1"></i>
                    </div>
                }
            </div>
            <!-- Agent Contact Info -->
            <div>
                <span class="badge bg-primary text-white rounded-pill px-3 py-1 fw-bold small mb-2 shadow-sm">Agente Responsable</span>
                <h2 class="fw-bold text-dark mb-1">@agente.Nombre @agente.Apellido</h2>
                <div class="d-flex flex-wrap gap-3 text-secondary mt-2">
                    <span><i class="bi bi-telephone-fill text-primary me-1"></i> @(string.IsNullOrEmpty(agente.Telefono) ? "No especificado" : agente.Telefono)</span>
                    <span><i class="bi bi-envelope-fill text-primary me-1"></i> @(string.IsNullOrEmpty(agente.Correo) ? "No especificado" : agente.Correo)</span>
                </div>
            </div>
            <!-- boton lista -->
            <div class="ms-md-auto mt-3 mt-md-0">
                <a asp-action="Agentes" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Volver a Agentes
                </a>
            </div>
        </div>
    </div>

    <!-- seccion propiedades -->
    <h3 class="fw-bold text-dark mb-4">Propiedades Disponibles</h3>

    <!-- cuadro propiedades -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var propiedad in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-hover-sm rounded-4 overflow-hidden bg-white">
                    <!-- Image -->
                    <div class="position-relative card-img-wrapper" style="height: 200px;">
                        @if (propiedad.ImagenesUrl != null && propiedad.ImagenesUrl.Count > 0)
                        {
                            <img src="@propiedad.ImagenesUrl[0]" class="w-100 h-100 object-fit-cover" alt="Propiedad" />
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex flex-column justify-content-center align-items-center bg-light text-muted">
                                <i class="bi bi-house-door fs-1 mb-2"></i>
                                <span class="small">Sin Imagen</span>
                            </div>
                        }
                        
                        <!-- Badges -->
                        <div class="position-absolute top-0 start-0 m-3 d-flex flex-column gap-1">
                            <span class="badge bg-primary text-white rounded-pill px-2.5 py-1 fw-bold fs-7 shadow-sm">
                                @propiedad.TipoPropiedadNombre
                            </span>
                            <span class="badge bg-success text-white rounded-pill px-2.5 py-1 fw-bold fs-7 shadow-sm">
                                @propiedad.TipoVentaNombre
                            </span>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small fw-semibold">Código: @propiedad.Codigo</span>
                            <span class="text-primary fw-bold fs-5">RD$ @propiedad.Precio.ToString("N2")</span>
                        </div>

                        <p class="card-text text-muted small text-truncate-2 mb-3">
                            @propiedad.Descripcion
                        </p>

                        <!-- Features -->
                        <div class="row row-cols-3 g-2 text-center border-top pt-3 mt-auto">
                            <div class="col">
                                <div class="p-1 rounded bg-light">
                                    <div class="small text-muted fw-semibold" style="font-size: 0.75rem;">Habs</div>
                                    <div class="fw-bold text-dark">@propiedad.CantidadHabitaciones</div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="p-1 rounded bg-light">
                                    <div class="small text-muted fw-semibold" style="font-size: 0.75rem;">Baños</div>
                                    <div class="fw-bold text-dark">@propiedad.CantidadBanos</div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="p-1 rounded bg-light">
                                    <div class="small text-muted fw-semibold" style="font-size: 0.75rem;">Mts²</div>
                                    <div class="fw-bold text-dark">@propiedad.TamanoMetros.ToString("N0")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Detalles boton -->
                    <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                        <a asp-action="Details" asp-route-id="@propiedad.Id" class="btn btn-outline-primary w-100 rounded-pill fw-semibold shadow-sm">
                            Ver Detalles
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info border-0 shadow-sm p-4 rounded-4 text-center mt-3" role="alert">
            <i class="bi bi-info-circle-fill fs-3 text-primary d-block mb-2"></i>
            <h5 class="fw-bold">Sin propiedades disponibles</h5>
            <p class="mb-0 text-secondary">Este agente no tiene propiedades disponibles en este momento.</p>
        </div>
    }
</div>