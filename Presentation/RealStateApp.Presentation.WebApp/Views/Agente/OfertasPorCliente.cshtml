@model RealStateApp.Application.ViewModels.Agente.AgentOfertasPorClienteViewModel

@{
    ViewData["Title"] = "Ofertas de " + Model.NombreCliente;
}

<div class="container my-5">
    <!-- Breadcrumb & Header -->
    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a asp-controller="Agente" asp-action="Index" class="text-decoration-none">Home del Agente</a></li>
                        <li class="breadcrumb-item"><a asp-controller="Agente" asp-action="PropiedadDetalle" asp-route-id="@Model.PropiedadId" class="text-decoration-none">Detalle de Propiedad</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Gestión de Ofertas</li>
                    </ol>
                </nav>
                <h2 class="fw-bold text-dark mb-0">
                    Ofertas de: <span class="text-primary">@Model.NombreCliente</span>
                </h2>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="Agente" asp-action="PropiedadDetalle" asp-route-id="@Model.PropiedadId" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Volver al detalle
                </a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm p-4 rounded-4 mb-4 d-flex align-items-center">
            <i class="bi bi-check-circle-fill fs-3 me-3"></i>
            <div class="fw-semibold text-dark">@TempData["SuccessMessage"]</div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning border-0 shadow-sm p-4 rounded-4 mb-4 d-flex align-items-center">
            <i class="bi bi-exclamation-circle-fill fs-3 text-warning me-3"></i>
            <div class="fw-semibold text-dark">@TempData["ErrorMessage"]</div>
        </div>
    }

    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
        <h4 class="fw-bold mb-4 text-dark">Historial de ofertas y respuestas</h4>
        
        @if (Model.Ofertas != null && Model.Ofertas.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-3 py-3">Fecha de la oferta</th>
                            <th class="py-3">Monto ofertado</th>
                            <th class="py-3">Estado de la oferta</th>
                            <th class="pe-3 py-3 text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var oferta in Model.Ofertas)
                        {
                            <tr>
                                <td class="ps-3 text-dark fw-medium">
                                    <i class="bi bi-calendar-event text-secondary me-2"></i>@oferta.FechaOferta.ToString("g")
                                </td>
                                <td class="fw-bold text-primary fs-5">
                                    RD$ @oferta.MontoOfertado.ToString("N2")
                                </td>
                                <td>
                                    @if (oferta.Estado == "Aceptada")
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-1"><i class="bi bi-check-circle me-1"></i>@oferta.Estado</span>
                                    }
                                    else if (oferta.Estado == "Rechazada")
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-1"><i class="bi bi-x-circle me-1"></i>@oferta.Estado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="bi bi-clock me-1"></i>@oferta.Estado</span>
                                    }
                                </td>
                                <td class="pe-3 text-end">
                                    @if (oferta.Estado == "Pendiente")
                                    {
                                        <div class="d-flex justify-content-end gap-2">
                                            <form asp-action="ResponderOferta" method="post" class="m-0">
                                                <input type="hidden" name="ofertaId" value="@oferta.OfertaId" />
                                                <input type="hidden" name="propiedadId" value="@Model.PropiedadId" />
                                                <input type="hidden" name="clienteId" value="@Model.ClienteId" />
                                                <input type="hidden" name="respuesta" value="Aceptada" />
                                                <button type="submit" class="btn btn-success rounded-pill px-4 py-1.5 shadow-sm fw-bold">
                                                    Aceptar
                                                </button>
                                            </form>
                                            
                                            <form asp-action="ResponderOferta" method="post" class="m-0">
                                                <input type="hidden" name="ofertaId" value="@oferta.OfertaId" />
                                                <input type="hidden" name="propiedadId" value="@Model.PropiedadId" />
                                                <input type="hidden" name="clienteId" value="@Model.ClienteId" />
                                                <input type="hidden" name="respuesta" value="Rechazada" />
                                                <button type="submit" class="btn btn-danger rounded-pill px-4 py-1.5 shadow-sm fw-bold">
                                                    Rechazar
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Oferta @oferta.Estado.ToLower() (Historial)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-journal-x fs-1 mb-2 d-block text-secondary"></i>
                <p class="mb-0">Este cliente no tiene ofertas en el historial de esta propiedad.</p>
            </div>
        }
    </div>
</div>
